*name
*call yesmemory
*perso:402570
*perso:403350,cont
*stand
*call *pascal
(*=y+,s0,s7*)program tssppr(output, input, BDVECT, BDERRN);
(* Extracted declarations from TSSBAS, TSPIC, TSSDML, TSSDMPR, TSSZT *)
(* Stubs only satisfy the compiler, no fidelity claim *)
const
  NoCmpsAddr = 0;
type
  BYTE = 0..255;
  word = record case integer of
    0:(i:integer); 1:(a:alfa); 2:(p:@integer); 3:(c:char)
  end;
  TBDVec = array [0..167] of word;
  AnyPtr = @integer;
var
  BDVECT: TBDVec;
  BDERRN: integer;
const
  C255 = 0;
  DLBUF = 1344;
  LTABCX = 450;
  LTABIN = 1350;
  LSSI = 340;
  LENLIT = 383;
  LENOP = 384;
  LENGMG = 5;
  LITI = 191;
  LITR = 95;
  LITA = 63;
  LITB = 383;
  LXBOREC = 500;
  LXBOINT = 4000;
  LABNUMBER = 24;
  NOPCMPSADDR = 0;
type
  LinT = packed array[1..11] of char;
  ALF6 = alfa;
  TSLANG = array [1..100] of alfa;
  TYPEM = packed array [1..DLBUF] of char;
  TYPEMI = record case integer of
             1:(I:integer);
             2:(A:TYPEM)
           end;
  TBYTE = integer;
  TPICOD = packed array [1..LENOP] of TBYTE;
  TSTEK = record case integer of
             1:(INT:array[1..3] of integer);
             2:(DES:record TIRR,VARR,NZ,NEL:integer; ADROP:integer end)
          end;
  TYPPIC = record
    NC,NM,NA,SSDMO:integer;
    IPCX,SSVAR,SSJUR,SSIDEN,SSPRIV:alfa;
    SSPED,SSD:integer;
    X:record case integer of 1:(II:integer); 2:(AA:alfa) end;
    X2,X3:alfa;
    SMES,NMG,XX4,AIMC,AEXXN,VOT,XL:integer;
    SDL,Y1,Y2,Y21,Y22:integer;
    Y3:real;
    ZAV,YPOBE:integer;
    BEGMG:array[1..LENGMG] of TSTEK;
    L:record case integer of
        1:(I:array[0..LITI] of integer);
        2:(R:array[0..LITR] of real);
        3:(A:array[0..LITA] of alfa);
        4:(B:array[0..LITB] of boolean);
        5:(C:packed array[0..LENLIT] of char)
      end;
    M:TPICOD
  end;
  TYPPIC2 = record x128,x129:integer end;
  DESREC = record PERSYS:integer; filler:array[1..8] of integer end;
  TROCH = record
    CXCXTL,TH,NOMZP:integer;
    XBOCT:record case integer of
             1:(REC:array[1..LXBOREC] of DESREC);
             2:(INT:array[1..LXBOINT] of integer)
           end
  end;
  TTABCX = record case integer of
             1:(INT:array[1..LTABIN] of integer);
             2:(ALF:array[1..LTABCX] of alfa)
           end;
  DESMETH = @DESMETH0;
  DESMETH0 = record
    mname:alfa;
    trnum,begpar,numpar:integer;
    mref:DESMETH
  end;
var
  PIC:@TYPPIC;
  PIC2:@TYPPIC2;
  SLANGM:TSLANG;
  XLAM:alfa;
  ERROR, C255V:integer;
  Ident:alfa;
  Pbegel,Pbegnab,PAIMC,PTABCX:@integer;
  C:char;
  BUF:record LEN,H,D,I:integer; M,MV:TYPEM end;
  ROCH:TROCH;
  TABCX:TTABCX;
  mf:file of integer;
  A,nm,IMQ1,IMQCT,SSNPRO:alfa;
  FFerrReady:boolean;
  fferr:text;
  TextName,IntName:LinT;
  RecMeths:array[1..127] of DESMETH;
  MParsRep,MParsDli:array[1..256] of integer;
  parep,padli:array[1..8] of integer;
  FElFlag,virel,SSSDM,NKOFlag,PERV2:boolean;
  VarAmount,VarPoint,MethOwner,nomsys,KONNAB,KONZAP,BEGNAB,
  STOBM,SSON,Obmeny,SSPERE:integer;
  NEMAD,RABORT,wac,NKO:boolean;
  VarNames:array[1..8] of alfa;
procedure PUTEOL; begin writeln end;
procedure PUTALF(A:alfa); begin write(A) end;
procedure PUTINT(A:integer); begin write(A) end;
procedure PUTCHR(A:char); begin write(A) end;
procedure PUTPOL; begin write('/') end;
(* TSSERR.ERROUT without the Op* GUI: print code and context. *)
procedure ERROUT(A:INTEGER; B3:ALF6; NEJT:INTEGER);
var SLine:packed array[1..150] of char;
    D1,D2,D3,K:integer;
    Found:boolean;
begin
  ERROR:=A;
  BDERRN:=A;
  write('ОШИБКА ',A,': ',B3,' ',NEJT,' ',IMQCT,' -> ',IMQ1);
  writeln;
  if FFerrReady then
  begin
    D1:=A div 100;
    D2:=(A div 10) mod 10;
    D3:=A mod 10;
    reset(fferr);
    Found:=false;
    while (not eof(fferr)) and (not Found) do
    begin
      for K:=1 to 150 do SLine[K]:=' ';
      readln(fferr,SLine);
      if (SLine[5]=chr(D1+ord('0'))) and
         (SLine[6]=chr(D2+ord('0'))) and
         (SLine[7]=chr(D3+ord('0'))) then Found:=true
    end;
    if Found then writeln(SLine) else
      writeln('COERR.TXT: НЕТ СТРОКИ ДЛЯ КОДА ',A)
  end
end;
procedure ERM(A:integer);
begin
  ERROUT(700+A,'K3T5CO',1)
end;
procedure SSVERK(T,MN:alfa); begin end;
procedure SSENDM;
begin
  writeln('МОДУЛЬ ',SSNPRO,' ПОЛЬЗОВАТЕЛЬ ',Ident,
          ' ОБМЕНЫ ',Obmeny)
end;
procedure INKOMP;
begin
  writeln('INKOMP SDL=',PIC@.SDL,' SSD=',PIC@.SSD,
          ' SSPED=',PIC@.SSPED,' IPCX=',PIC@.IPCX)
end;
procedure INBPEM;
var JJ:integer;
begin
  for JJ:=1 to KONZAP do
    if TABCX.ALF[JJ]='SYS---' then
      writeln('INBPEM SYS--- REC=',JJ)
end;
procedure IMQ; begin end;
procedure dml(PERV:BOOLEAN);
var K,J,JJ:integer; Tok6:alfa; Found:integer;
begin
  K:=1;
  while (K<=BUF.LEN) and (BUF.M[K]=' ') do K:=K+1;
  for JJ:=1 to 6 do Tok6[JJ]:=' ';
  for JJ:=1 to 6 do
    if K+JJ-1<=BUF.LEN then Tok6[JJ]:=BUF.M[K+JJ-1];
  Found:=0;
  for J:=1 to 100 do
    if SLANGM[J]=Tok6 then Found:=J;
  writeln('DML LEN=',BUF.LEN,' OP=',Found,' ',Tok6)
end;
function SSSDMF:boolean; begin SSSDMF:=false end;
function VarLength(VarNumber:BYTE):integer;
var R:integer;
begin
  R:=parep[VarNumber];
  case R of
    0,3:R:=1;
    1,11,12,13:R:=2;
    2,5:R:=4;
    6:R:=8;
    7:R:=0
  end;
  VarLength:=R*padli[VarNumber]
end;
function howcom(N:alfa):BYTE;
var Ch:char; K:integer;
begin
  writeln('ВНИМАНИЕ: НЕОТКОМПИЛИРОВАННАЯ ОПЕРАЦИЯ ',N);
  writeln('1 - компилировать далее; 2 - компилировать эту;',
          ' 3 - пропустить; 4 - игнорировать');
  write('ВЫБОР [1]: ');
  K:=1;
  readln(Ch);
  if (Ch>='1') and (Ch<='4') then K:=ord(Ch)-ord('0');
  howcom:=K
end;
function SIZEOF(var X:TROCH):integer; begin SIZEOF:=100 end;
procedure FAssign(var F:text; N:LinT);
begin
  TextName:=N;
  FFerrReady:=(N[1]='C') and (N[2]='O') and (N[3]='E') and (N[4]='R')
end;
procedure FAssignI(var F:file of integer; N:LinT);
begin
  IntName:=N
end;
procedure FClose(var F:text);
begin
  FFerrReady:=false
end;
procedure FCloseI(var F:file of integer);
begin
end;
procedure ERASE(var F:file of integer);
begin
end;
procedure HALT(E:integer); begin end;

procedure SSBF5; external;
(* W1: COMTUP port dropped the untyped TPCMPAD1 entry in favour of
   typed TPCMP1I/A/B/P wrappers (see patches/tsspr.patch). This last
   call site has no slot number; keep the name local so it is not an
   unresolved external. Slot mapping belongs to W4. *)
procedure TPCMPAD1(var P:TYPEM); begin end;
procedure TPCMP1I(var p:integer; k:integer); external;
procedure TPCMP1A(var p:alfa;    k:integer); external;
procedure TPCMP1B(var p:boolean; k:integer); external;
procedure TPCMP1P(var p:AnyPtr;  k:integer); external;
procedure TPCMPP1(j:integer); external;
procedure TPCMPL1(j:integer); external;
procedure TPCMPIN1(j:integer); external;
function APIC:@TYPPIC; external;
function APIC2:@TYPPIC2; external;
procedure WPASRA; external;
procedure VPASR6; external;
function EXN:integer; external;
function ITLEN:integer; external;

procedure zamtrb;
var NN,Trn,Trdlic,Trdlil,Trdliv:integer;
    AA:array[1..256] of integer;
begin
  SSBF5;
  reset(mf);
  while not eof(mf) do
  begin
    read(mf,Trn);
    read(mf,Trdlic);
    for NN:=1 to Trdlic do read(mf,AA[NN]);
    read(mf,Trdlil);
    for NN:=1 to (Trdlil+3) div 2 do read(mf,AA[NN]);
    read(mf,Trdliv)
  end;
  writeln('ZAMTRB: ПЕРЕДАНО ЗАПИСЕЙ=',Trn,' ДЛИН=',Trdlic)
end;

