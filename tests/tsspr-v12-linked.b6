         FOR I:=0 TO 9 DO BEGIN PUTINT(PIC1.L.I[I]);PUTEOL END;*)

        END;

 3 :
  BEGIN TPCMPP1  (16470);
TPCMPIN1 (541);
 END;

 PIC@:=PIC1;
 vPASR6
END; (* OPBIB *)


       PROCEDURE ISPVIP;

BEGIN (* ISPVIP *)
 BUF.D:=BUF.I+1;
 BUF.M:=BUF.MV;
 BUF.M[BUF.D]:=CHR(C255);
 BUF.H:=0;
 BUF.I:=0;
 C:=' ';
END; (* ISPVIP *)

procedure CompileMethod;
var dlic,stp:integer;
    cc:integer;
    tt:typem;
    pic4:typpic;
begin
   BEGIN TPCMP1A(VarNames[1], 64);
TPCMP1I(parep[1], 65);
TPCMP1I(padli[1], 66);
TPCMP1B(FElFlag, 67);
TPCMPAD1 (tt);
TPCMP1I(dlic, 68);
TPCMPP1  (1317);
TPCMPP1  (288);
TPCMPP1  (36);
TPCMPP1  (0);
TPCMPP1  (16896);
TPCMPP1  (9486);
TPCMPP1  (8197);
TPCMPP1  (9220);
TPCMPP1  (0);
TPCMPP1  (2);
TPCMPP1  (3650);
TPCMPP1  (1317);
TPCMPP1  (1312);
TPCMPP1  (36);
TPCMPP1  (1024);
TPCMPP1  (16896);
TPCMPP1  (9486);
TPCMPP1  (8197);
TPCMPP1  (9219);
TPCMPP1  (0);
TPCMPP1  (6);
TPCMPP1  (3650);
TPCMPP1  (1317);
TPCMPP1  (544);
TPCMPP1  (36);
TPCMPP1  (2048);
TPCMPP1  (16896);
TPCMPP1  (9486);
TPCMPP1  (8202);
TPCMPP1  (9218);
TPCMPP1  (0);
TPCMPP1  (10);
TPCMPP1  (3650);
TPCMPIN1 (29);
 END;

  write(mf,dlic);
  pic4:=pic@;
  dlic:=1;
  while tt[dlic]<>chr(C255) do
    begin
      putchr(tt[dlic]);
      dlic:=dlic+1;
    end;
  ispvip;
  VarAmount:=1;
  VarPoint:=1;
  (*writeln('Compiling of ',VarNames[1]);*)
  dml(true);
  dlic:=pic@.nm div 2;
  write(mf,dlic);
  for dlic:=1 to pic@.nm div 2 do
    begin
      stp:=256*pic@.m[dlic*2]+pic@.m[dlic*2-1];
      write(mf,stp);
    end;
  write(mf,pic@.nc);
  for dlic:=0 to (pic@.nc+1) div 2 do
    begin
      stp:=256*ord(pic@.l.c[dlic*2+1])+ord(pic@.l.c[dlic*2]);
      write(mf,stp);
    end;
  dlic:=0;
  for cc:=1 to VarAmount do
    dlic:=dlic+VarLength(cc);
  write(mf,dlic);
(*  for dlic:=1 to VarPoint do
    write(mf,parep[dlic]);
  for dlic:=1 to VarPoint do
    write(mf,padli[dlic]);*)
  pic@:=pic4;
end;

procedure PrintMethods;
var reco,csh:integer;cm:desmeth;f:text;
begin
FAssign(f,'methods.ret');
rewrite(f);
for reco:=1 to roch.nomzp do
 if recmeths[reco]<>nil then
  begin
    writeln(f,'  Rec number ',reco,' , ',tabcx.alf[reco],' :');
    cm:=recmeths[reco];
    while cm<>nil do
      begin
        writeln(f,' Method number ',cm@.trnum,' , ',cm@.mname,' :');
        writeln(f,'Par amount : ',cm@.numpar);
        writeln(f,'Variables  :   rep  &  dli');
        writeln(f,'--------------------------');
        writeln(f,'Main value : ',mparsrep[cm@.begpar]:5,
                            '   ',mparsdli[cm@.begpar]:5);
        for csh:=2 to cm@.numpar do
          writeln(f,'Par ',csh-1:6,' : ',mparsrep[cm@.begpar+csh-1]:5,
                                   '   ',mparsdli[cm@.begpar+csh-1]:5);
        cm:=cm@.mref;
        writeln(f,'====================================');
      end;
    writeln(f,'--------------------------------------');
  end;
FClose(f);
end;

