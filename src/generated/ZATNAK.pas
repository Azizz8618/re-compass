WITH CULX.CUPX DO REPEAT
READCON(NEXT);IF HAЧ THEN EXIT;
NEXT:=TRUE;
WITH CULX.CUCX DO BEGIN
DMLCALL(296);
END;
UNTIL NEXT;UNTIL NEXTPAR;
END;



(* SECTION ? .HOB *)
