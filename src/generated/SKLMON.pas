begin
  for J:=1 to 160 do BUF.M[J]:=' ';
  case N of
    13: begin
      BUF.LEN:=39;
      BUF.M[1]:='B';BUF.M[2]:='З';BUF.M[3]:='Я';BUF.M[4]:='T';
