    BEGIN TPCMPP1  (300);
TPCMPP1  (2821);
TPCMPP1  (7746);
TPCMPP1  (522);
TPCMPIN1 (7709);
 END;

   IF EXN <> 0 THEN
   BEGIN
    PUTEOL;PUTALF('ER.40:');
    PUTALF(slangm[64]); PUTALF(PIC@.X.AA);  PUTPOL; ERROR:=40;
    GOTO 3
   END ELSE
    BEGIN TPCMPP1  (3358);
TPCMPIN1 (7428);
 END;

  END;
 END;
 IF TEKOPL = 171 then
 BEGIN
    BEGIN TPCMP1I(SIMOPI.I, 63);
TPCMPP1  (1317);
TPCMPP1  (544);
TPCMPP1  (36);
TPCMPP1  (0);
TPCMPP1  (16896);
TPCMPIN1 (7438);
 END;

