(* SECTION ? .S *)
(*CYMMИPOBAHИE ЗAPПЛATЫ ЗA MECЯЦ*)
FUNCTION SUM(MES:INT):REAL;
VAR S:REAL;
BEGIN
S:=0;
DMLCALL(291);
WHILE MOЖHO DO BEGIN 
  DMLCALL(292);
  WITH ЗAT DO IF MEC=MES THEN BEGIN S:=S+OЗAPП+ДЗAPП END ;
  DMLCALL(293); END ;
SUM:=S;
END;



