*name GSHT
*call yesmemory
*no list
*super
*system
      PROGRAM GSHT
      CALL SHTAMP(0.,0.,0,0.)
      CALL SHTAMP(0.,0.,1,1.)
      CALL SHTAMP(0.,0.,1,0.)
      STOP
      END
      SUBROUTINE SHTAMP(XX,YY,NS,L)
      REAL A(100),X(50),Y(50),GR
      IF(NS.GT.0) GOTO 111
      GR=6.5  $  NLIN=11  $  NSTEP=30
      A(01)=01.7 $ A(02)=00.0
      A(03)=01.7 $ A(04)=05.5
      A(05)=00.7 $ A(06)=05.5
      A(07)=00.7 $ A(08)=03.0
      A(09)=04.0 $ A(10)=00.0
      A(11)=04.0 $ A(12)=05.5
      A(13)=05.5 $ A(14)=05.5
      A(15)=05.5 $ A(16)=00.0
      A(17)=06.5 $ A(18)=01.5
      A(19)=18.5 $ A(20)=01.5
      A(21)=18.5 $ A(22)=02.0
      A(23)=13.5 $ A(24)=02.0
      A(25)=13.5 $ A(26)=03.5
      A(27)=18.5 $ A(28)=03.5
      A(29)=18.5 $ A(30)=04.0
      A(31)=06.5 $ A(32)=04.0
      A(33)=06.5 $ A(34)=05.5
      A(35)=18.5 $ A(36)=05.5
      A(37)=13.5 $ A(38)=04.0
      A(39)=13.5 $ A(40)=00.0
      A(41)=16.0 $ A(42)=01.5
      A(43)=16.0 $ A(44)=02.0
      A(45)=14.0 $ A(46)=02.0
      A(47)=14.0 $ A(48)=03.5
      A(49)=14.5 $ A(50)=03.5
      A(51)=14.5 $ A(52)=02.0
      A(53)=15.0 $ A(54)=02.0
      A(55)=15.0 $ A(56)=04.0
      A(57)=17.0 $ A(58)=04.0
      A(59)=17.0 $ A(60)=02.0
      GOTO 222
  111 GR=6.5  $  NLIN=3  $  NSTEP=14
      A(01)=00.7 $ A(02)=00.0
      A(03)=00.7 $ A(04)=01.5
      A(05)=01.7 $ A(06)=01.5
      A(07)=01.7 $ A(08)=00.0
      A(09)=04.0 $ A(10)=00.0
      A(11)=04.0 $ A(12)=01.5
      A(13)=05.5 $ A(14)=01.5
      A(15)=05.5 $ A(16)=00.0
      A(17)=06.5 $ A(18)=01.5
      A(19)=18.5 $ A(20)=01.5
      A(21)=17.5 $ A(22)=01.5
      A(23)=17.5 $ A(24)=00.0
      A(25)=17.5 $ A(26)=01.0
      A(27)=18.5 $ A(28)=01.0
  222 IF(L.GT.0.1.OR.L.LT.-0.1) GOTO 1
      CALL GRID(XX,YY,GR,0.5,1,NLIN)
      DO 2 I=1,NSTEP
      X(I)=XX+A(I*2-1)
    2 Y(I)=YY+A(I*2)
      GOTO 3
    1 CALL GRID(XX,YY-GR,0.5,GR,NLIN,1)
      DO 4 I=1,NSTEP
      Y(I)=YY-A(I*2-1)
    4 X(I)=XX+A(I*2)
    3 DO 5 I=1,NSTEP,2
      CALL MOVE(X(I),Y(I),0)
    5 CALL MOVE(X(I+1),Y(I+1),1)
      RETURN
      END
      SUBROUTINE GRID(A,B,C,D,E,F)
      PRINT 1,A,B,C,D,E,F
    1 FORMAT(1X,'GRID',6F9.2)
      END
      SUBROUTINE MOVE(X,Y,N)
      PRINT 2,X,Y,N
    2 FORMAT(1X,'MOVE',2F9.2,I3)
      END
*execute
*end file
``````
