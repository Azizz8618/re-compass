TPCMPP1  (9486);
TPCMPP1  (8202);
TPCMPP1  (9227);
TPCMPP1  (0);
TPCMPP1  (6);
TPCMPP1  (3650);
TPCMPP1  (2597);
TPCMPP1  (3104);
TPCMPP1  (36);
TPCMPP1  (2048);
TPCMPP1  (16896);
TPCMPIN1 (7438);
 END;

(*      numpar:=itlen div 2;*)
      begpar:=csh;
      csh:=csh+numpar;
      mref:=nil;
    end;
  if dmeth@.numpar=0 then
    begin
      dispose(dmeth);
      dmeth:=nil;
    end;
  SMeth:=dmeth;
end;
procedure MapMethod(NomRec:integer);
var cmeth:desmeth;
begin
  if RecMeths[NomRec]=nil then
    RecMeths[NomRec]:=SMeth else
    begin
      cmeth:=RecMeths[NomRec];
      while cmeth@.mref<>nil do
        cmeth:=cmeth@.mref;
      cmeth@.mref:=SMeth;
    end;
end;

