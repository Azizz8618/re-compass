procedure PutBuf(s:alfa);
var k:integer;
begin
  for k:=1 to 6 do
  begin
    BUF.LEN:=BUF.LEN+1;
    BUF.M[BUF.LEN]:=s[k]
  end
end;
procedure NewStep;
begin
  BUF.LEN:=0; BUF.I:=1; BUF.H:=1
end;
procedure SetKey(k:alfa);
begin
