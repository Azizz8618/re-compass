(*=y+,s0,s7*)program cgetbdkey(output, BDVECT, BDERRN);
(* Inline copy of COMTUP source, unmodified PicCode. *)
const cGetd=221411c; cPutd=26211511c; cFind=11c; cLast=02c;
type
  TPath = packed array [1..40] of char;
  PicT = record
    nc,nm,na,smes,ssdmo: integer;
    m: array [0..383] of integer;
    l: array [0..383] of integer
  end;
  word = record case integer of
    0:(i:integer); 1:(a:alfa); 2:(p:@integer); 3:(c:char);
    4:(pp:@PicT)
  end;
  TBDVec = array [0..167] of word;
var
  BDVECT: TBDVec;
  BDERRN: integer;
  Number,R: integer;
  p:@PicT;
  rp:@integer;
procedure PASACD(var i:integer); FORTRAN;
procedure PASSETAR(i:integer); EXTERNAL;
procedure pasbdi; external;
procedure pasbd; external;
procedure GetPic(var q:@PicT);
var i:integer;
begin
  _(
  if BDVECT[160].i = 0 then begin
    new(q); q@.nc := 0; q@.nm := 0; q@.na := 0;
    q@.smes := 0; q@.ssdmo := 0;
    for i := 0 to 383 do begin q@.m[i] := 0; q@.l[i] := 0 end;
    BDVECT[160].pp := q
  end else q := BDVECT[160].pp
  _);
end;
function PicCode(j:integer):integer;
var op:integer;
begin
  _(
  op := j mod 256; PicCode := 0;
  if op = 1 then PicCode := cPutd;
  if op = 2 then PicCode := cFind;
  if op = 16 then PicCode := cGetd;
  _);
end;
procedure SaveAdr(k:integer);
var q:@PicT;
begin
  _(
  GetPic(q);
  if q@.na <= 382 then begin
    q@.l[q@.na] := BDVECT[k].i; q@.na := q@.na + 2
  end
  _);
end;
procedure SSBF5;
var i,j:integer;
begin
  _(
  for j := 0 to 167 do BDVECT[j].i := 0;
  i := 1270000c; PASACD(i); PASSETAR(270000c); pasbdi;
  BDVECT[3].i := 0
  _);
end;
procedure TPCMP1I(var p:integer; k:integer);
begin
  _( BDVECT[k].i := ord(ref(p)); SaveAdr(k) _);
end;
procedure TPCMPP1(j:integer);
var q:@PicT;
begin
  _(
  GetPic(q);
  if q@.nc <= 382 then begin q@.m[q@.nc] := j; q@.nc := q@.nc + 2 end
  _);
end;
procedure TPCMPIN1(j:integer);
var q:@PicT; code:integer;
begin
  _(
  GetPic(q);
  if q@.nc <= 382 then begin q@.m[q@.nc] := j; q@.nc := q@.nc + 2 end;
  code := PicCode(j);
  if code <> 0 then begin BDVECT[3].i := code; pasbd end;
  if j = 7514 then begin
    BDVECT[3].i := 352453c;
    pasbd;
    rp := BDVECT[24].p;
    rp@ := BDVECT[20].i
  end
  _);
end;
procedure MakeFixture;
var i:integer; m:array[1..4] of integer;
begin
  i := 1270000c; PASACD(i);
  PASSETAR(270000c);
  i := 1270001c;
  newd('bdkey ', i);
  opend('bdkey ');
  m[1]:=111111; m[2]:=222222; m[3]:=333333; m[4]:=444444;
  putd('kbd001', m);
  BDVECT[8].a := 'kbd001'; BDVECT[3].i := 11c; pasbd;
end;
begin
  MakeFixture;
  writeln('EXPECTED BDKEY=', BDVECT[29].i oct);
  Number := 0; R := -1;
  TPCMP1I(Number,22);
  TPCMP1I(R,24);
  TPCMPP1(36); TPCMPP1(0); TPCMPP1(19712);
  TPCMPP1(36); TPCMPP1(512); TPCMPP1(16896);
  TPCMPIN1(7514);
  p := BDVECT[160].pp;
  writeln('PIC NC=',p@.nc,' NA=',p@.na);
  writeln('SLOT22=',BDVECT[22].i oct,' SLOT24=',BDVECT[24].i oct);
  writeln('SLOT29=',BDVECT[29].i oct);
  writeln('R=',R,' BDERRN=',BDERRN);
END.
