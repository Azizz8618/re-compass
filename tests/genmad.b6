ФOPMAT ПAP
ПAP.ИMЯ_ПAP.HAЗB_ПAP.COKP_TИП.ИMЯ*
ПACKAЛ "AЛФ.ЗH:=TEKCПИ;ПAP.HOMEP:=ПAP.HOMEP+10;
&&ПOCTAB ПAP;ПOCTAB TИП;BKЛЮЧИ B ПA-ПAP&&"
ФOPMAT ATP
ATP.ИMЯ_ATP.ЗH*
ПACKAЛ "&&ПOCTAB ATP&&"
ФOPMAT TEMA
TEMA.HOMEP_OTДEЛ.HAЗB*
ПACKAЛ "
WITH ИCПOЛH DO_(HOMEP:=0;YPOB:=-1;TEKИCП:=HOMEP_);
&&ПOCTAB TEMA;HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH&&"
ФOPMAT COИCП
OTДEЛ.HAЗB*
ПACKAЛ "WITH ИCПOЛH DO_(HOMEP:=HOMEP+1;TEKCOИ:=HOMEP_);
ЦEЛ.ЗH:=TEKИCП;
&&HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH;BKЛЮЧИ B ИC-ИCП&&"
ФOPMAT ПOДИCП
OTДEЛ.HAЗB*
