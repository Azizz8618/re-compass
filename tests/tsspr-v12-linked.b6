          PROCEDURE PODSHE;
LABEL 1;
VAR PIC3:TYPPIC;
    PSSDMO,DliC,ReCo,csh,hc : INTEGER;
    nm:alf6;
    wac:boolean;

function SMeth : desmeth;
var dmeth:desmeth;
begin
  new(dmeth);
  WITH DMETH@ DO
    begin
       BEGIN TPCMP1A(mname, 69);
TPCMP1I(trnum, 70);
TPCMP1I(numpar, 71);
TPCMP1I(MParsRep[csh], 72);
TPCMP1I(MParsDli[csh], 73);
TPCMPP1  (2597);
