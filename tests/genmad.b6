ПAP [ZCПEЦ_CПEЦOБOPYДOBAHИE_CПEЦOБ_ДEЙ*]
ПAP [ZAMOP_AMOPT.OTЧИCЛ.HA ПOЛHOE BOCCTAHOBЛEHИE_AMOPT_ДEЙ*]
ПAP [ZCTOP_OПЛATA PAБOT CTOPOHHИX OPГAHИЗAЦИЙ_CTOP_ДEЙ*]
ПAP [ZПOCH_ПЛATA ЗA OCHOBHЫE ФOHДЫ_OCH.Ф_ДEЙ*]
