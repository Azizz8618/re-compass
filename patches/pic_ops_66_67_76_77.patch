+(* W(low,high) words emitted by UCOMPAS whose high byte is a PIC state
+   operation: 77 mgth, 66 mgfal, 67 mgtrue, 76 mgel. Low byte 00 is
+   bixod. The state is kept in BDVECT so that a deck can observe it.
+   MARS op53 words that perform the same moves are documented in the
+   report; an extra pasbd here disturbs later MARS microprograms,
+   so the integrated port writes the slots directly. *)
+procedure PicStateCode(j:integer);
+begin
+  _(
+  if j = 19712 then BDVECT[sNrec].i := BDVECT[sPicVal].i;
+  if j = 16896 then BDVECT[sTret].i := BDVECT[sPicVal].i;
+  if j = 17152 then BDVECT[sNset].i := BDVECT[sPicVal].i;
+  if j = 19456 then BDVECT[sNel].i := BDVECT[sPicVal].i
+  _);
+end;
 (* PIC word W(low,high): low byte is the resident operation. *)
 (* HYPOTHESIS: mapping of PIC operations to MARS microcode. *)
